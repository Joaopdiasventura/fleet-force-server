    "/v1/fleet/analyze": {
      "post": {
        "summary": "Analyze",
        "description": "Analyze a UTF-8 normalized or UFMG CSV directly, without writing shared reports.",
        "operationId": "analyze_v1_fleet_analyze_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_v1_fleet_analyze_post"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "400": {
            "description": "Invalid state or request parameters"
          },
          "413": {
            "description": "Upload exceeds configured size limit"
          },
          "415": {
            "description": "Unsupported file format"
          },
          "422": {
            "description": "Invalid CSV encoding, schema or numerical data"
          },
          "500": {
            "description": "Unexpected analysis failure"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Body_analyze_v1_fleet_analyze_post": {
        "properties": {
          "file": {
            "type": "string",
            "contentMediaType": "application/octet-stream",
            "title": "File"
          },
          "uf": {
            "type": "string",
            "title": "Uf",
            "default": "MG"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_analyze_v1_fleet_analyze_post"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
